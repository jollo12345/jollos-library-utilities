@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/JLU-shared-targets.cmake")
  find_dependency(SDL3 CONFIG COMPONENTS SDL3-shared)
  include("${CMAKE_CURRENT_LIST_DIR}/JLU-shared-targets.cmake")
  set(JLU_JLU-shared_FOUND TRUE)
endif()

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/JLU-static-targets.cmake")
  find_dependency(SDL3 CONFIG COMPONENTS SDL3-static)
  include("${CMAKE_CURRENT_LIST_DIR}/JLU-static-targets.cmake")
  set(JLU_JLU-static_FOUND TRUE)
endif()

if(NOT TARGET JLU::JLU)
  if(TARGET JLU::JLU-shared)
    add_library(JLU::JLU ALIAS JLU::JLU-shared)
  elseif(TARGET JLU::JLU-static)
    add_library(JLU::JLU ALIAS JLU::JLU-static)
  endif()
endif()

check_required_components(JLU)
